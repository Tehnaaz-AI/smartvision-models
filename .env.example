# ==============================================================================
# SmartVision Smart Glasses Environment Configuration Template
# Copy this file to .env and configure for your cloud deployment
# ==============================================================================

# --- Cloud Database (Supabase / Firebase / Cloudflare) ---
SMARTVISION_CLOUD_PROVIDER=supabase
SMARTVISION_CLOUD_API_URL=https://your-project.supabase.co/rest/v1
SMARTVISION_CLOUD_API_KEY=your-service-role-or-anon-key
SMARTVISION_LOCAL_CACHE_PATH=data/smartvision_cache.sqlite

# --- Caregiver Emergency Alert Dispatcher ---
CAREGIVER_PHONE=+91-9876543210
CAREGIVER_WEBHOOK_URL=https://api.twilio.com/2010-04-01/Accounts/YOUR_ACCOUNT/Messages.json
TWILIO_AUTH_TOKEN=your_twilio_token_here

# --- Smart Glasses Hardware Configuration ---
GLASSES_SERIAL_PORT=COM3
GLASSES_BAUDRATE=115200
GLASSES_CAMERA_BURST_FPS=15
GLASSES_MICRO_DISPLAY_SPI_BUS=0
GLASSES_DISPLAY_TYPE=SSD1306_128X64

# --- Hugging Face & AI Models ---
HF_HOME=~/.cache/huggingface
HF_TOKEN=hf_your_huggingface_token
TTS_DEFAULT_LANGUAGE=te
ASR_MODEL_ID=openai/whisper-tiny
LLM_MODEL_ID=Qwen/Qwen2.5-0.5B-Instruct

# --- FastAPI Server ---
HOST=0.0.0.0
PORT=8000
DEBUG=false
